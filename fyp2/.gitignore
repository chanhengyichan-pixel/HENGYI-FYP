# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/

# Model weights
*.pt
*.onnx

# Output files (keep .gitkeep)
output/logs/*
output/screenshots/*
!output/logs/.gitkeep
!output/screenshots/.gitkeep

# Runtime databases and captured images (created on device, not committed)
output/*.db
output/*.jpg
output/.dashboard_secret   # session signing key, generated on first start
output/zones.json          # zones drawn in Settings > Room zones (site-specific)

# NCNN exports (regenerate on the Pi) and recorded test videos
*_ncnn_model/
videos/

# Scratch / temporary scripts
test_config.py

# IDE / OS
.vscode/
.idea/
.DS_Store
